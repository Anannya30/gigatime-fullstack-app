# =============================================================================
# GigaTIME — environment variables (backend + frontend)
# -----------------------------------------------------------------------------
# Copy to backend/.env (local) or let backend_startup.sh assemble it on the VM
# from Secret Manager. NEVER commit real values — backend/.env is gitignored.
# On GCP the SECRET-marked values come from Secret Manager, not from this file.
# =============================================================================

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=gigatime_backend.settings.production
SECRET_KEY=                      # SECRET — Secret Manager: gigatime-django-secret-key. No insecure default in prod.
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# PostgreSQL
#   Option B (self-hosted on the VM, DEFAULT): DB_HOST=db (compose service name)
#   Option A (Cloud SQL):                      DB_HOST=<cloud sql private IP / socket>
# ---------------------------------------------------------------------------
DB_HOST=db
DB_NAME=gigatime_db
DB_USER=gigatime_user
DB_PASSWORD=                     # SECRET — Secret Manager: gigatime-db-password
POSTGRES_PASSWORD=               # same value as DB_PASSWORD (used by the postgres container in Option B)

# ---------------------------------------------------------------------------
# Redis (Celery broker / channel layer)
#   Option B (self-hosted): redis://redis:6379/0
#   Option A (Memorystore): redis://<memorystore-ip>:6379/0  (Secret Manager: gigatime-redis-url)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# SMTP (email: 2FA OTP + slide-completion notifications) — already configured
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=                   # SECRET
EMAIL_USE_SSL=True

# ---------------------------------------------------------------------------
# Object storage — GCS via the S3-compatible API
# -----------------------------------------------------------------------------
# FALLBACK RULE: if AWS_ACCESS_KEY_ID **and** S3_BUCKET are set, use S3-compatible
# storage; otherwise fall back to local filesystem paths under MEDIA_ROOT.
#
# Suggested Django settings branch (backend/.../settings/production.py):
#
#   import os
#   if os.environ.get("AWS_ACCESS_KEY_ID") and os.environ.get("S3_BUCKET"):
#       # GCS via S3-compatible endpoint (django-storages[boto3])
#       STORAGES = {"default": {"BACKEND": "storages.backends.s3.S3Storage"}}
#       AWS_ACCESS_KEY_ID     = os.environ["AWS_ACCESS_KEY_ID"]
#       AWS_SECRET_ACCESS_KEY = os.environ["AWS_SECRET_ACCESS_KEY"]
#       AWS_STORAGE_BUCKET_NAME = os.environ["S3_BUCKET"]
#       AWS_S3_ENDPOINT_URL   = os.environ["AWS_S3_ENDPOINT_URL"]   # https://storage.googleapis.com
#       AWS_S3_REGION_NAME    = "asia-south1"                       # India residency
#   else:
#       # Local/env-based paths (current behavior) — MEDIA_ROOT on disk.
#       STORAGES = {"default": {"BACKEND": "django.core.files.storage.FileSystemStorage"}}
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=               # SECRET — HMAC accessId (Secret Manager: gigatime-s3-access-key)
AWS_SECRET_ACCESS_KEY=           # SECRET — HMAC secret   (Secret Manager: gigatime-s3-secret-key)
AWS_S3_ENDPOINT_URL=https://storage.googleapis.com
S3_BUCKET=gigatime-slides-mum    # the asia-south1 single-region bucket

# ---------------------------------------------------------------------------
# Frontend (Vite) — baked at BUILD time
# ---------------------------------------------------------------------------
# VITE_API_BASE = backend base URL the SPA calls (e.g. http://BACKEND_IP:8000/api).
# Pass as a --build-arg at image build time (see deploy_frontend.sh note).
VITE_API_BASE=/api
