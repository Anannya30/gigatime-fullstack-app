# GigaTIME backend environment variables.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Django
SECRET_KEY=
DEBUG=

# PostgreSQL
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Redis (Channels + Celery broker/result backend)
REDIS_URL=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend
FRONTEND_URL=

# Hugging Face (model downloads for inference)
HF_TOKEN=
