# GigaTIME backend environment variables.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Django
SECRET_KEY=
DEBUG=

# PostgreSQL
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Redis (Channels + Celery broker/result backend)
REDIS_URL=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend
FRONTEND_URL=

# Hugging Face (model downloads for inference)
HF_TOKEN=

# SMTP (email + OTP 2FA)
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=
EMAIL_USE_SSL=
OTP_EXPIRY_MINUTES=10
