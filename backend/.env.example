# GigaTIME backend environment variables.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Django
SECRET_KEY=
DEBUG=

# PostgreSQL
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Redis (Channels + Celery broker/result backend)
REDIS_URL=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend
FRONTEND_URL=

# Hugging Face (model downloads for inference)
HF_TOKEN=

# SMTP (email + OTP 2FA).
#  - Port 465 (SSL):      EMAIL_USE_SSL=True,  EMAIL_USE_TLS=False
#  - Port 587 (STARTTLS): EMAIL_USE_SSL=False, EMAIL_USE_TLS=True
# For a Gmail address, SMTP_HOST=smtp.gmail.com and SMTP_PASSWORD must be a
# Gmail "App Password" (16 chars), not the normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
OTP_EXPIRY_MINUTES=10
