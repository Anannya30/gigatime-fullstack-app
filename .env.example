# Root environment file for docker compose.
# Copy this to ".env" (same folder as docker-compose.yml) and fill in values.
#   cp .env.example .env
#
# These values create the PostgreSQL container AND are handed to the backend,
# so the app and the database always agree (no password mismatch possible).

# --- Database ---
POSTGRES_DB=gigatime_db
POSTGRES_USER=gigatime_user
# Choose any password you like; it is only used inside this machine.
POSTGRES_PASSWORD=change-this-password

# --- Web access ---
# Addresses the app is allowed to be opened from. For a private/trusted server
# the simplest value is *  (accept any). To be stricter, list them, e.g.:
#   ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx,192.168.1.50
ALLOWED_HOSTS=*
